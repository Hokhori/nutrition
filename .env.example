# ============================================================================
#  Nutrition — configuration
#  Copiez ce fichier en `.env` et renseignez les valeurs.
#  Générez les secrets d'un coup avec :  node scripts/generate-secrets.mjs
# ============================================================================

# --- Base de données --------------------------------------------------------
# Dev local (docker-compose.dev.yml) :
DATABASE_URL=postgres://nutrition:nutrition@localhost:5432/nutrition
#
# Déploiement docker-compose.yml : NE PAS définir DATABASE_URL ici — il est
# construit automatiquement depuis les variables ci-dessous. Personnalisez-les
# (surtout DB_PASSWORD) en production.
DB_USER=nutrition
DB_PASSWORD=nutrition
DB_NAME=nutrition

# Port exposé par l'app sur l'hôte (docker-compose.yml).
APP_PORT=3000

# --- Auth / multi-utilisateurs (obligatoire) --------------------------------
# Email du compte admin créé au premier démarrage (seed).
ADMIN_EMAIL=admin@example.com
# Mot de passe INITIAL de l'admin : stockez le HASH, pas le mot de passe.
#   node scripts/hash-password.mjs "<votre-mot-de-passe>"
# Ensuite le mot de passe vit dans la base ; cette variable ne sert qu'au seed.
WEB_PASSWORD_HASH=
# Secret de session iron-session (>= 32 chars).  openssl rand -base64 32
SESSION_SECRET=

# --- MCP / API (facultatif) -------------------------------------------------
# Token Bearer d'admin partagé, accepté sur /mcp et /api (rétro-compat / CI).
# Chaque utilisateur a de toute façon son propre token perso dans son profil.
#   openssl rand -hex 32
MCP_TOKEN=

# --- URL publique -----------------------------------------------------------
# URL publique de l'instance (issuer OAuth + ressource MCP). OBLIGATOIRE en
# production (HTTPS). En dev, laissez vide → http://localhost:3000.
# Ex : https://nutrition.exemple.org
PUBLIC_URL=

# --- OAuth : connecteur Claude mobile/desktop (facultatif) ------------------
# Nécessaire uniquement pour brancher le MCP via l'app Claude (mobile/desktop).
# Client pré-enregistré à coller dans Claude (Réglages > Connecteurs).
#   OAUTH_CLIENT_ID     : openssl rand -hex 16
#   OAUTH_CLIENT_SECRET : openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Secret de signature des tokens OAuth (>= 32 chars ; repli sur SESSION_SECRET).
#   openssl rand -base64 32
OAUTH_JWT_SECRET=

# --- Assistant IA in-app (facultatif) ---------------------------------------
# Clé API Anthropic pour l'assistant du site (facturé sur votre compte
# Anthropic). Modèle utilisé : claude-haiku-4-5 (le moins cher). Absent →
# l'assistant renvoie 503, le reste de l'app fonctionne normalement.
ANTHROPIC_API_KEY=

# --- Mentions légales / RGPD (obligatoire en production publique) ------------
# Identité de l'exploitant (responsable de traitement), affichée dans les pages
# /legal/mentions et /legal/confidentialite. Non renseigné → « [à compléter] ».
SITE_NAME=Nutrition
# Nom ou raison sociale de l'éditeur.
OPERATOR_NAME=
# Adresse postale (siège).
OPERATOR_ADDRESS=
# Email de contact RGPD / réclamations.
OPERATOR_EMAIL=
# Numéro d'entreprise (BCE/KBO en Belgique) ou équivalent.
OPERATOR_LEGAL_ID=
# N° de TVA (facultatif).
OPERATOR_VAT=
# Ressort juridique applicable (défaut : Belgique).
OPERATOR_JURISDICTION=Belgique
# Contact DPO / point de contact RGPD si distinct de OPERATOR_EMAIL (facultatif).
DPO_EMAIL=
# Hébergeur affiché dans les mentions (défaut : Hetzner, UE).
HOSTING_PROVIDER=

# --- Divers -----------------------------------------------------------------
# Fuseau horaire pour le calcul du « jour » nutritionnel.
APP_TZ=Europe/Brussels
# User-Agent envoyé à OpenFoodFacts (identifiez votre instance + un contact).
# Ex : mon-instance-nutrition (https://nutrition.exemple.org)
OFF_USER_AGENT=

# --- Contribution OpenFoodFacts (facultatif) --------------------------------
# Compte contributeur OpenFoodFacts (créez-le sur https://world.openfoodfacts.org)
# pour permettre à l'app d'ajouter des produits RÉELS scannés. Absent → les
# outils de contribution renvoient une erreur, la lecture d'OFF reste OK.
OFF_USER=
OFF_PASSWORD=
# Base d'écriture. Défaut : production. Mettez https://world.openfoodfacts.net
# pour tester sur le sandbox (staging) sans polluer la vraie base.
OFF_WRITE_BASE=
