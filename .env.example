# --- Base de données ---
# En dev local (docker-compose.dev.yml) :
DATABASE_URL=postgres://nutrition:nutrition@localhost:5432/nutrition
# En prod (dans ~/stacks/nutrition/.env), pointe vers le service `db` du compose :
# DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@db:5432/nutrition

# --- Auth web (interface navigateur) ---
# Mot de passe unique : stocke le HASH (voir `pnpm exec node scripts/hash-password.mjs <motdepasse>`)
WEB_PASSWORD_HASH=
# Secret de session iron-session (>= 32 chars). Générer : openssl rand -base64 32
SESSION_SECRET=

# --- MCP / API ---
# Token Bearer partagé, exigé sur /mcp et /api. Générer : openssl rand -hex 32
MCP_TOKEN=

# --- OAuth (connecteur Claude sur mobile/desktop) ---
# URL publique de l'app (issuer OAuth). Ex : https://nutrition.hokhori.be
PUBLIC_URL=
# Client pré-enregistré à coller dans Claude (Réglages > Connecteurs).
# Générer : openssl rand -hex 16  /  openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Secret de signature des tokens OAuth (>= 32 chars). Générer : openssl rand -base64 32
# (repli sur SESSION_SECRET si absent)
OAUTH_JWT_SECRET=

# --- Divers ---
# Fuseau horaire pour le calcul du "jour" nutritionnel
APP_TZ=Europe/Brussels
